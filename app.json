{
  "expo": {
    "name": "Mi Ciudad Colón",
    "slug": "mi-ciudad-colon",
    "scheme": "miciudad",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "uner.miciudad.apk",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Usamos Face ID para que entres rápido sin escribir la contraseña.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "uner.miciudad.apk",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyALICq-WF41KwhKQnO_foJQ6VSv6gIpiGo"
        }
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-vector-icons/ionicons",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 220
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación para mostrarte qué lugares tenés cerca."
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Usamos la cámara para leer el QR de los carteles y sacar fotos de tus visitas.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Elegís fotos de tu galería para guardarlas en tu recorrido.",
          "cameraPermission": "Usamos la cámara para sacar fotos de tus visitas.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5aa45ab6-e6ba-4d03-b3e3-2582cc2a28d2"
      }
    },
    "owner": "grupo17"
  }
}
