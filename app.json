{
  "expo": {
    "name": "Mi Ciudad Colón",
    "slug": "mi-ciudad-colon",
    "scheme": "miciudad",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "ar.tur.colon.miciudad",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Usamos Face ID para que entres rápido sin escribir la contraseña."
      }
    },
    "android": {
      "package": "ar.tur.colon.miciudad",
      "permissions": [
        "android.permission.USE_BIOMETRIC"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-vector-icons/ionicons",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 220
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png"
  }
}