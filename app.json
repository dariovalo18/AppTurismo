{
  "expo": {
    "name": "Mi Ciudad Colón",
    "slug": "mi-ciudad-colon",
    "scheme": "miciudad",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "ar.tur.colon.miciudad",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Usamos Face ID para que entres rápido sin escribir la contraseña.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "ar.tur.colon.miciudad",
      "permissions": [
        "android.permission.USE_BIOMETRIC"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-vector-icons/ionicons",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 220
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación para mostrarte qué lugares tenés cerca."
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Usamos la cámara para leer el QR de los carteles y sacar fotos de tus visitas.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Elegís fotos de tu galería para guardarlas en tu recorrido.",
          "cameraPermission": "Usamos la cámara para sacar fotos de tus visitas.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png"
  }
}
